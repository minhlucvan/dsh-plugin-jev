{
  "name": "dsh-plugin-jev",
  "description": "TypeSafe Jev (System One) integration for DeepSeek Harness: typed, calibrated decisions as agent tools, plus token accounting that shows what the reasoning costs.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minhlucvan/dsh-plugin-jev.git"
  },
  "homepage": "https://github.com/minhlucvan/dsh-plugin-jev#readme",
  "bugs": {
    "url": "https://github.com/minhlucvan/dsh-plugin-jev/issues"
  },
  "author": "Luc Van Minh",
  "keywords": [
    "cordis",
    "cordis-plugin",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "jev",
    "typesafe",
    "system-one",
    "classification",
    "token-optimization"
  ],
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "version": "0.1.0",
  "imports": {
    "#src/*.tsx": "./src/*.tsx",
    "#src/*": "./src/*.ts"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./benchmark": {
      "types": "./lib/benchmark.d.ts",
      "default": "./lib/benchmark.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./commands": {
      "types": "./lib/commands.d.ts",
      "default": "./lib/commands.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./routes": {
      "types": "./lib/routes.d.ts",
      "default": "./lib/routes.js"
    },
    "./skills": {
      "types": "./lib/skills.d.ts",
      "default": "./lib/skills.js"
    },
    "./tools": {
      "types": "./lib/tools.d.ts",
      "default": "./lib/tools.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "tsdown --config-loader unrun --config tsdown.config.ts && tsdown --config-loader unrun --config tsdown.client.config.ts && node scripts/wrap-client.mjs && node scripts/verify-client.mjs",
    "build:host": "tsdown --config-loader unrun --config tsdown.config.ts",
    "build:client": "tsdown --config-loader unrun --config tsdown.client.config.ts && node scripts/wrap-client.mjs && node scripts/verify-client.mjs",
    "fmt": "oxfmt --config .oxfmtrc.json --write src tests",
    "fmt:check": "oxfmt --config .oxfmtrc.json --check src tests",
    "lint": "oxlint --config .oxlintrc.json --type-check --deny-warnings src tests",
    "lint:fix": "oxlint --config .oxlintrc.json --type-check --deny-warnings --fix src tests",
    "test": "vitest run",
    "bench": "node scripts/benchmark.mjs",
    "bench:live": "node scripts/benchmark.mjs --live",
    "bench:report": "node scripts/benchmark.mjs --report"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cordisjs/plugin-loader": "^1.0.0-rc.5",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-code-runtime": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-scope": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^22.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cordis": "^4.0.0-rc.7",
    "jsdom": "^28.1.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vitest": "^4.1.8",
    "zustand": "^5.0.15"
  }
}
